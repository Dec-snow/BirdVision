# ============================================================
# BirdVision 环境变量配置文件
# 复制此文件为 .env 并修改为你的实际配置
#   cp .env.example .env
# ============================================================

# --- Flask 安全密钥（生产环境必改！） ---
# 生成随机密钥: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-secret

# --- 开发服务器监听配置（仅 python run.py 启动时生效） ---
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=1

# --- LLM 提供商选择 ---
# ollama | deepseek | mimo | openai_compatible
LLM_PROVIDER=deepseek

# --- DeepSeek 配置 ---
# DeepSeek: https://platform.deepseek.com → 创建 API Key
LLM_API_KEY=sk-你的API_Key填在这里
LLM_CLOUD_MODEL=deepseek-chat

# --- 小米 MiMo 配置 ---
# MiMo: https://api.xiaomimimo.com → 创建 API Key
MIMO_API_KEY=sk-你的MiMo_API_Key
MIMO_MODEL=mimo-v2.5

# --- 自定义 API 地址（仅 openai_compatible 模式需要）---
# LLM_BASE_URL=https://你的服务地址

# --- Ollama 本地模式配置（LLM_PROVIDER=ollama 时生效）---
LLM_API_URL=http://localhost:11434/api/chat
LLM_MODEL_NAME=bird-expert:latest
